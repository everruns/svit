    given-names: Mykhailo
  - name: "Everruns contributors"
repository-code: "https://github.com/everruns/svit"
url: "https://github.com/everruns/svit"
license: MIT
version: "0.1.0"
keywords:
  - agent
  - runtime
  - lisp
  - sandbox
  - memory
