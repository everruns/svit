{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "svit-site",
  "compatibility_date": "2026-07-31",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    {
      "pattern": "svit.everruns.com",
      "custom_domain": true
    }
  ],
  "workers_dev": true,
  "observability": {
    "enabled": true
  }
}
