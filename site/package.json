{
  "name": "svit-site",
  "version": "0.1.0",
  "packageManager": "pnpm@10.34.5",
  "private": true,
  "type": "module",
  "scripts": {
    "sync:docs": "node scripts/sync-docs.mjs",
    "predev": "pnpm run sync:docs",
    "dev": "astro dev",
    "prebuild": "pnpm run sync:docs",
    "build": "astro build",
    "postbuild": "node scripts/normalize-sitemap.mjs && node scripts/verify-site.mjs",
    "preview": "astro preview",
    "pretypecheck": "pnpm run sync:docs",
    "typecheck": "astro check",
    "lint:docs": "nimbus-docs lint",
    "lint:docs:fix": "nimbus-docs lint --fix",
    "prepreview:cf": "astro build",
    "preview:cf": "wrangler dev",
    "predeploy": "astro check && pnpm build",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@cloudflare/nimbus-docs": "^0.9.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@iconify-json/ph": "^1.2.2",
    "astro": "^7.3.5",
    "astro-icon": "^1.2.0",
    "clsx": "^2.1.1",
    "mermaid": "^11.17.2",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@tailwindcss/vite": "^4.3.3",
    "pagefind": "^1.5.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "wrangler": "^4.147.0"
  }
}
