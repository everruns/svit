---
import "../styles/global.css";

const operations = [
  { name: "discover(path)", copy: "List immediate children" },
  { name: "read(path)", copy: "Read a process value" },
  { name: "write(path, value)", copy: "Transactionally update memory or library" },
  { name: "remove(path)", copy: "Transactionally remove memory or library data" },
  { name: "exec(path, input)", copy: "Run a /lib script or installed /bin executable" },
];

const works = [
  "One namespace for memory, scripts, mount snapshots, system metadata, and outbox",
  "One process protocol across host callers, agent tools, and Svit Lisp",
  "Atomic memory, script, and outbox commits with complete rollback",
  "Bounded Svit Lisp 2 execution with no ambient host authority",
  "Deterministic snapshots, restore, and isolated forks",
  "In-memory VAST control with version checks and bounded retry receipts",
  "Bounded read-only folder and Turso query snapshots under /mounts",
];

const later = [
  "Live and writable projections of the outside world",
  "Addressable communication between runtimes",
  "Runtime-native identity, authentication, and capabilities",
  "Durable storage, scheduling, and message delivery",
  "Authenticated network control, durable receipts, and distributed process ownership",
  "Stronger isolation through Wasm or OS process boundaries",
];

const denied = ["filesystem", "network", "environment", "process", "clock", "randomness", "module loader", "native extensions"];
