---
import "../styles/global.css";

const model = [
  {
    number: "01",
    title: "Own one memory tree",
    copy: "A process keeps bounded, serializable state that survives across activations and can be read by its scripts.",
    tag: "/memory",
  },
  {
    number: "02",
    title: "Run one activation",
    copy: "A named restricted-Lua script receives input and runs against a transactional working copy of the process state.",
    tag: "main(input)",
  },
  {
    number: "03",
    title: "Commit as one change",
    copy: "Memory, staged scripts, and buffered message intents commit together. Any failure leaves the prior state untouched.",
    tag: "v → v + 1",
  },
  {
    number: "04",
    title: "Snapshot or fork",
    copy: "Capture canonical committed state, restore it later, or fork an independently mutable child for another line of work.",
    tag: "sha256(root)",
  },
];

const works = [
  "Transactional memory, scripts, and outbox intents",
  "Deterministic JSON snapshots with integrity hashes",
  "Restore and fork with isolated future mutations",
  "Fresh restricted-Lua VM for every activation",
  "Configurable execution, heap, value, and output limits",
];

const later = [
  "Project the outside world into the same structured value space",
  "Addressable communication between runtimes",
  "Runtime-native identity, authentication, and capabilities",
  "Durable storage, scheduling, and message delivery",
  "Stronger isolation through Wasm or OS process boundaries",
];

const denied = ["filesystem", "network", "environment", "process", "clock", "randomness", "module loader", "native extensions"];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#f3f0e8" />
    <meta
      name="description"
      content="Svit gives agents a structured space to remember, act, and evolve: memory and executable behavior together, changed through bounded transactions."
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://svit.everruns.com/" />
    <meta property="og:title" content="Give the agent a space to remember, act, and evolve" />
    <meta
      property="og:description"
      content="Memory and executable behavior together in one structured, self-reflective, transactional space."
    />
    <meta property="og:image" content="https://svit.everruns.com/og-space.png" />
    <meta property="og:image:width" content="1792" />
    <meta property="og:image:height" content="933" />
    <meta property="og:image:alt" content="Svit process states moving from memory through activation and commit to a fork" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Give the agent a space to remember, act, and evolve" />
    <meta name="twitter:description" content="Memory and executable behavior together in one structured, self-reflective, transactional space." />
    <meta name="twitter:image" content="https://svit.everruns.com/og-space.png" />
    <link rel="canonical" href="https://svit.everruns.com/" />
    <title>Svit — give the agent a space to remember, act, and evolve</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header page-shell">
      <a class="wordmark" href="#top" aria-label="Svit home">SVIT<span>_</span></a>
      <nav aria-label="Primary navigation">
        <a href="#model">Model</a>
        <a href="#runtime">Runtime</a>
        <a href="#status">Status</a>
        <a class="nav-github" href="https://github.com/everruns/svit">GitHub <span aria-hidden="true">↗</span></a>
      </nav>
    </header>

    <main id="main">
      <section id="top" class="hero page-shell">
        <div class="hero-copy">
          <p class="eyebrow"><span class="signal"></span> Research-stage runtime designed for agents</p>
          <h1>Give the agent a space to <em>remember</em>, act, and evolve.</h1>
          <p class="hero-lede">
            Svit keeps memory and executable behavior together in one structured, self-reflective space. Agents can inspect it, script it, and evolve it through bounded transactions.
          </p>
          <p class="hero-proof">Structured. Scriptable. Transactional. Self-reflective. Forkable.</p>
          <div class="hero-actions">
            <a class="button button-dark" href="#model">Explore the process model <span aria-hidden="true">↓</span></a>
            <a class="text-link" href="https://github.com/everruns/svit">Explore the source <span aria-hidden="true">↗</span></a>
          </div>
        </div>

        <figure class="space-card">
          <div class="space-card-title">
            <span>ONE EVOLVING AGENT SPACE</span>
            <span>PROCESS / 001</span>
          </div>
          <svg class="space-map" viewBox="0 0 560 500" role="img" aria-labelledby="space-map-title space-map-description">
            <title id="space-map-title">One evolving agent space</title>
            <desc id="space-map-description">
              An agent activates a Svit process containing memory, behaviors, and a projected view of the world. The process changes transactionally and can be snapshotted, restored, or forked.
            </desc>
            <defs>
              <marker id="space-arrow" markerWidth="9" markerHeight="9" refX="7" refY="3" orient="auto">
                <path d="M0 0 L0 6 L8 3 Z" class="space-arrow-head"></path>
              </marker>
              <marker id="projection-arrow" markerWidth="9" markerHeight="9" refX="7" refY="3" orient="auto">
                <path d="M0 0 L0 6 L8 3 Z" class="projection-arrow-head"></path>
              </marker>
            </defs>

            <text x="28" y="42" class="space-map-kicker">ONE AGENT PROCESS</text>
            <text x="28" y="72" class="space-map-heading">REMEMBER · ACT · REACH</text>

            <g class="agent-node">
              <circle cx="56" cy="242" r="34"></circle>
              <circle cx="56" cy="234" r="7" class="agent-head"></circle>
              <path d="M40 258 Q56 241 72 258" class="agent-body"></path>
              <text x="56" y="294" text-anchor="middle">AGENT</text>
            </g>
            <path d="M96 242 H144" class="space-line" marker-end="url(#space-arrow)"></path>
            <text x="119" y="227" text-anchor="middle" class="space-map-note">ACTIVATE</text>

            <g class="agent-space">
              <circle cx="300" cy="242" r="148" class="space-boundary"></circle>
              <circle cx="300" cy="242" r="51" class="space-core"></circle>
              <text x="300" y="237" text-anchor="middle" class="space-core-label">AGENT</text>
              <text x="300" y="261" text-anchor="middle" class="space-core-label">SPACE</text>

              <g class="space-node memory-node">
                <circle cx="300" cy="122" r="42"></circle>
                <text x="300" y="118" text-anchor="middle">MEMORY</text>
                <text x="300" y="141" text-anchor="middle" class="space-map-note">REMEMBER</text>
              </g>
              <g class="space-node behavior-node">
                <circle cx="198" cy="302" r="42"></circle>
                <text x="198" y="298" text-anchor="middle">BEHAVIORS</text>
                <text x="198" y="321" text-anchor="middle" class="space-map-note">ACT</text>
              </g>
              <g class="space-node world-node">
                <circle cx="402" cy="302" r="42"></circle>
                <text x="402" y="298" text-anchor="middle">WORLD</text>
                <text x="402" y="321" text-anchor="middle" class="space-map-note">REACH</text>
              </g>
            </g>

            <path d="M445 292 C466 284 473 266 488 249" class="projection-line" marker-end="url(#projection-arrow)"></path>
            <text x="475" y="278" text-anchor="middle" class="space-map-note">TYPED</text>
            <text x="475" y="290" text-anchor="middle" class="space-map-note">PROJECTION</text>
            <g class="external-node">
              <rect x="492" y="202" width="58" height="78"></rect>
              <text x="521" y="235" text-anchor="middle">EXTERNAL</text>
              <text x="521" y="253" text-anchor="middle">SYSTEMS</text>
            </g>

            <path d="M300 390 V418" class="space-line" marker-end="url(#space-arrow)"></path>
            <text x="318" y="410" class="space-map-note">COMMIT</text>
            <path d="M200 430 Q300 408 400 430 V465 Q300 486 200 465 Z" class="snapshot-node"></path>
            <text x="300" y="450" text-anchor="middle" class="snapshot-label">SNAPSHOT · RESTORE · FORK</text>
          </svg>
          <figcaption class="space-card-foot">
            <span>UNIFIED INSIDE</span>
            <span>EXPLICIT AT THE BOUNDARY</span>
          </figcaption>
        </figure>

        <div class="hero-index" aria-hidden="true">
          <span>SVIT / 001</span>
          <span>RESEARCH-STAGE</span>
          <span>JUL · 2026</span>
        </div>
      </section>

      <section class="thesis page-shell section-rule">
        <p class="section-label">The premise</p>
        <blockquote>
          Memory and behavior belong in <span>one coherent space.</span>
        </blockquote>
        <p class="thesis-note">
          A space the agent can understand from inside: structured state, discoverable scripts, bounded transitions, and explicit authority.
        </p>
      </section>

      <section id="model" class="model page-shell section-rule">
        <div class="section-intro">
          <p class="section-label">01 / Process model</p>
          <h2>Small enough to reason about.</h2>
          <p>One process. One committed root. One activation at a time.</p>
        </div>
        <div class="model-grid">
          {model.map((item) => (
            <article class="model-card">
              <div class="model-card-top">
                <span>{item.number}</span>
                <code>{item.tag}</code>
              </div>
              <h3>{item.title}</h3>
              <p>{item.copy}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="transaction page-shell section-rule">
        <div class="transaction-copy">
          <p class="section-label">02 / Transaction boundary</p>
          <h2>Success commits once. Failure commits nothing.</h2>
          <p>
            Each activation works on a private copy. Syntax, runtime, conversion, validation, and limit failures all roll back memory, scripts, outbox, and version together.
          </p>
          <div class="invariant">
            <span class="invariant-mark">✓</span>
            <p><strong>The invariant</strong><br />No partial process state escapes an activation.</p>
          </div>
        </div>

        <div class="commit-diagram" role="img" aria-label="Committed process state is copied for an activation and either atomically committed or rolled back">
          <div class="commit-row">
            <span class="commit-id">A</span>
            <div>
              <small>COMMITTED ROOT · v12</small>
              <strong>memory + scripts + outbox</strong>
            </div>
            <span class="commit-status">STABLE</span>
          </div>
          <div class="commit-connector"><span>working copy</span></div>
          <div class="commit-row commit-row-active">
            <span class="commit-id">B</span>
            <div>
              <small>ACTIVATION</small>
              <strong>script(input) → candidate root</strong>
            </div>
            <span class="commit-status">BOUNDED</span>
          </div>
          <div class="commit-split">
            <div>
              <span>VALID</span>
              <strong>commit · v13</strong>
            </div>
            <div>
              <span>ANY FAILURE</span>
              <strong>rollback · v12</strong>
            </div>
          </div>
        </div>
      </section>

      <section id="runtime" class="sandbox">
        <div class="page-shell sandbox-inner">
          <div class="sandbox-copy">
            <p class="section-label section-label-light">03 / Guest boundary</p>
            <h2>No ambient authority.</h2>
            <p>
              Guest scripts get an explicit, versioned language surface—not the host operating system. Every activation starts in a fresh VM built from an allowlist.
            </p>
            <p class="security-note">
              This is a tested runtime layer, not proof of hostile same-process multi-tenancy. Production isolation still needs a Wasm or OS boundary.
            </p>
          </div>
          <div class="surface-panel">
            <div class="surface-allowed">
              <p>VISIBLE TO GUEST</p>
              <code>memory</code>
              <code>input</code>
              <code>scripts.list()</code>
              <code>scripts.read(name)</code>
              <code>scripts.save(name, source)</code>
              <code>log.info(message, fields)</code>
              <code>send(address, message)</code>
            </div>
            <div class="surface-denied">
              <p>ABSENT BY DEFAULT</p>
              <ul>
                {denied.map((item) => <li><span>×</span>{item}</li>)}
              </ul>
            </div>
          </div>
        </div>
      </section>

      <section class="example page-shell">
        <div class="section-intro example-intro">
          <p class="section-label">04 / The smallest useful script</p>
          <h2>State in. State out.</h2>
          <p>A named script defines <code>main(input)</code>. The runtime owns the transition around it.</p>
        </div>
        <div class="code-window">
          <div class="code-heading">
            <span>counter.lua</span>
            <span>SVIT LUA 1</span>
          </div>
          <pre><code><span class="code-dim">01</span>  <span class="code-keyword">function</span> <span class="code-call">main</span>(input)
<span class="code-dim">02</span>    memory.count = memory.count + input.by
<span class="code-dim">03</span>
<span class="code-dim">04</span>    log.info(<span class="code-string">"counter updated"</span>, &#123;
<span class="code-dim">05</span>      count = memory.count
<span class="code-dim">06</span>    &#125;)
<span class="code-dim">07</span>
<span class="code-dim">08</span>    <span class="code-keyword">return</span> &#123; count = memory.count &#125;
<span class="code-dim">09</span>  <span class="code-keyword">end</span></code></pre>
          <div class="code-result">
            <span>INPUT</span><code>&#123; by: 3 &#125;</code>
            <span>OUTPUT</span><code>&#123; count: 9 &#125;</code>
            <span>VERSION</span><code>3 → 4</code>
          </div>
        </div>
        <div class="quickstart">
          <span>RUN THE EXECUTABLE EXAMPLE</span>
          <code>cargo run -p svit --example durable_counter</code>
          <a href="https://github.com/everruns/svit#quick-start" aria-label="Open the Svit quick start on GitHub">↗</a>
        </div>
      </section>

      <section id="status" class="status page-shell section-rule">
        <div class="section-intro status-intro">
          <p class="section-label">05 / From slice to system</p>
          <h2>Start with a kernel. Grow toward an agent runtime.</h2>
          <p>The current slice tests the core semantics. The larger direction adds projections, communication, identity, durable execution, and stronger isolation.</p>
        </div>
        <div class="status-grid">
          <div class="status-list status-works">
            <div class="status-heading"><span></span> IMPLEMENTED NOW</div>
            <ul>
              {works.map((item) => <li><span>✓</span>{item}</li>)}
            </ul>
          </div>
          <div class="status-list status-later">
            <div class="status-heading"><span></span> RESEARCH DIRECTION</div>
            <ul>
              {later.map((item) => <li><span>—</span>{item}</li>)}
            </ul>
          </div>
        </div>
        <p class="status-footnote">
          Security claims track executable evidence. The repository includes a threat model, adversarial tests, and an explicit negative specification.
        </p>
      </section>

      <section class="closing">
        <div class="page-shell closing-inner">
          <p class="eyebrow"><span class="signal"></span> Open source · MIT licensed</p>
          <h2>Design the runtime<br />agents actually need.</h2>
          <div class="closing-actions">
            <a class="button button-light" href="https://github.com/everruns/svit">View Svit on GitHub <span aria-hidden="true">↗</span></a>
            <a href="https://github.com/everruns/svit/blob/main/docs/vision.md">Read the vision</a>
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer page-shell">
      <a class="wordmark" href="#top">SVIT<span>_</span></a>
      <p>Researching durable, transactional runtime semantics for agent processes.</p>
      <div>
        <a href="https://github.com/everruns/svit">GitHub</a>
        <a href="https://github.com/everruns/svit/blob/main/SECURITY.md">Security</a>
        <a href="https://github.com/everruns">Everruns</a>
      </div>
    </footer>
  </body>
</html>
