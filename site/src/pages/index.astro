---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import "../styles/home.css";

const documents = [
  ["Overview", "Orientation, runnable quick start, and process model.", "/overview/"],
  ["Vision", "Research direction, runtime model, and explicit limits.", "/vision/"],
  ["Control protocol", "Versioned atomic transitions for multiple clients.", "/control-protocol/"],
  ["Security", "Threat boundaries and vulnerability reporting.", "/security/"],
  ["Changelog", "Published changes to the runtime.", "/changelog/"],
];

const head = [{
  tag: "script" as const,
  attrs: { type: "application/ld+json" },
  content: JSON.stringify({
    "@context": "https://schema.org",
    "@type": "SoftwareSourceCode",
    name: "Svit",
    description: "A research-stage Rust runtime for durable agent state and reusable code.",
    codeRepository: "https://github.com/everruns/svit",
    programmingLanguage: "Rust",
    license: "https://opensource.org/license/mit",
    url: "https://svit.everruns.com",
    author: { "@type": "Organization", name: "Everruns", url: "https://everruns.com" },
  }),
}];
---

<BaseLayout
  title="Svit — research-stage agent runtime"
  description="A research-stage Rust runtime for durable agent state and reusable code."
  markdownUrl="/index.md"
  head={head}
>
  <div class="index-shell">
    <Header showSidebar={false} />

    <main id="main-content" class="project-index">
      <section class="project-heading" aria-labelledby="project-title">
        <div>
          <h1 id="project-title">Svit</h1>
          <p>Research-stage Rust runtime</p>
        </div>
        <dl class="project-facts">
          <div><dt>Status</dt><dd>Runnable, unstable API</dd></div>
          <div><dt>Language</dt><dd>Rust</dd></div>
          <div><dt>License</dt><dd>MIT</dd></div>
        </dl>
      </section>

      <section class="project-summary" aria-labelledby="summary-title">
        <h2 id="summary-title">Current scope</h2>
        <div>
          <p>
            Svit keeps structured memory, named Svit Lisp scripts, inbox state,
            buffered message intents, and runtime metadata in one serializable
            process. Each activation commits one complete next version or
            commits nothing.
          </p>
          <p class="status-note">
            There is no stable release. Svit is not a proven hostile
            multi-tenant isolation boundary; untrusted production workloads
            still require an outer Wasm or OS process boundary.
          </p>
        </div>
      </section>

      <section class="project-documents" aria-labelledby="documents-title">
        <div class="section-heading">
          <h2 id="documents-title">Documents</h2>
          <span>Canonical repository sources</span>
        </div>
        <div class="document-list">
          {documents.map(([title, description, href]) => (
            <a href={href}>
              <strong>{title}</strong>
              <span>{description}</span>
              <b aria-hidden="true">→</b>
            </a>
          ))}
        </div>
      </section>

      <section class="source-row" aria-labelledby="source-title">
        <div>
          <h2 id="source-title">Source</h2>
          <p>The implementation, examples, tests, and research record live in one repository.</p>
        </div>
        <a href="https://github.com/everruns/svit">github.com/everruns/svit <span aria-hidden="true">↗</span></a>
      </section>
    </main>

    <footer class="site-footer">
      <span>Svit</span>
      <nav aria-label="Footer">
        <a href="/llms.txt">llms.txt</a>
        <a href="https://github.com/everruns/svit">GitHub</a>
        <a href="https://everruns.com">Everruns</a>
      </nav>
    </footer>
  </div>
</BaseLayout>
