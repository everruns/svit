---
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex" />
    <title>Not found — Svit</title>
  </head>
  <body class="error-page">
    <main class="error-card">
      <p class="eyebrow">404 / no committed route</p>
      <h1>This path rolled back.</h1>
      <p>The page you requested is not part of the current Svit site.</p>
      <a class="button button-dark" href="/">Return to Svit <span aria-hidden="true">↗</span></a>
    </main>
  </body>
</html>
