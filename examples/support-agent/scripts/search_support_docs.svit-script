(define (starts-with text pattern)
  (if (null pattern)
      true
      (if (null text)
          false
          (if (= (first text) (first pattern))
              (starts-with (tail text) (tail pattern))
              false))))

(define (contains text pattern)
  (if (null pattern)
      true
      (if (null text)
          false
          (if (starts-with text pattern)
              true
              (contains (tail text) pattern)))))

(define (has-keyword query keyword)
  (contains (chars query) (chars keyword)))

(define (main input)
  (let ((query (value-get input "/query"))
        (account-recovery (read "/memory/docs/0"))
        (password-reset (read "/memory/docs/1"))
        (refunds (read "/memory/docs/2")))
    (if (or (has-keyword query "refund")
            (has-keyword query "purchase")
            (has-keyword query "billing"))
        (value-array refunds account-recovery)
        (if (or (has-keyword query "password")
                (has-keyword query "reset"))
            (value-array password-reset account-recovery)
            (value-array account-recovery password-reset)))))
