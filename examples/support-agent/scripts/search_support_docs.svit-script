(define (starts-with text pattern)
  (if (null pattern)
      true
      (if (null text)
          false
          (if (= (first text) (first pattern))
              (starts-with (tail text) (tail pattern))
              false))))

(define (contains text pattern)
  (if (null pattern)
      true
      (if (null text)
          false
          (if (starts-with text pattern)
              true
              (contains (tail text) pattern)))))

(define (has-keyword query keyword)
  (contains (chars query) (chars keyword)))

(define (commit-retrieval account source-ids required-ticket documents)
  (let ((retrieval
          (value-map
            "account" account
            "source_ids" source-ids
            "required_ticket" required-ticket)))
    (do
      (write "/memory/request/retrieval" retrieval)
      (value-map
        "account" account
        "documents" documents
        "source_ids" source-ids
        "required_ticket" required-ticket))))

(define (main input)
  (let ((request-id (value-get input "/request_id"))
        (expected-id (read "/memory/request/id"))
        (query (read "/memory/request/question"))
        (result (read "/memory/request/result"))
        (account (read "/mounts/account_context/data/0"))
        (account-recovery
          (value-map
            "id" "account-recovery"
            "content" (read "/mounts/support_docs/data/account-recovery.md")))
        (password-reset
          (value-map
            "id" "password-reset"
            "content" (read "/mounts/support_docs/data/password-reset.md")))
        (refunds
          (value-map
            "id" "refunds"
            "content" (read "/mounts/support_docs/data/refunds.md"))))
    (if (not (= request-id expected-id))
        (panic "request id mismatch")
        (if (not (value-null? result))
            (panic "support result already committed")
            (if (or (has-keyword query "refund")
                    (has-keyword query "purchase")
                    (has-keyword query "billing"))
                (commit-retrieval
                  account
                  (value-array "refunds" "account-recovery")
                  ()
                  (value-array refunds account-recovery))
                (if (or (has-keyword query "password")
                        (has-keyword query "reset"))
                    (commit-retrieval
                      account
                      (value-array "password-reset" "account-recovery")
                      ()
                      (value-array password-reset account-recovery))
                    (commit-retrieval
                      account
                      (value-array "account-recovery" "password-reset")
                      "account-recovery"
                      (value-array account-recovery password-reset))))))))
